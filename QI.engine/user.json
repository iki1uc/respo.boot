export const Engine = {
    state: {
        pump: 0,        // Energie, die sich aufbaut
        cpuJumpA: 0,    // Formel A – Vorhersage
        cpuJumpB: 0,    // Formel B – Orbitkorrektur
        active: 1       // Grundaktivität
    },

    memory: {
        hits: 0,        // Treffer von Formel A
        logs: []        // Chronik
    },

    // USER-Impuls – der erste Funke
    userImpulse() {
        return USER.level + this.state.active;
    },

    // Formel A – sieht die Zukunft
    predictiveEngine() {
        const active = this.userImpulse();
        const jumpA = active + Math.floor(this.state.pump / 6);

        this.state.cpuJumpA = jumpA;

        if (jumpA > 0) {
            this.memory.hits++;
        }

        this.log(`Formel A: jumpA=${jumpA}, pump=${this.state.pump}`);

        // Übergabe an Formel B
        return this.orbitFusion(jumpA);
    },

    // Formel B – korrigiert die Bahn
    orbitFusion(jumpA) {
        const active = this.userImpulse();
        const jumpB = active + Math.floor(this.state.pump / 8);

        this.state.cpuJumpB = jumpB;

        this.log(`Formel B: jumpB=${jumpB}, fromA=${jumpA}`);

        return {
            A: jumpA,
            B: jumpB,
            user: USER.name,
            level: USER.level,
            pump: this.state.pump,
            hits: this.memory.hits
        };
    },

    // Energie erhöhen
    pumpUp(value = 1) {
        this.state.pump += value;
        this.log(`pumpUp: +${value}, pump=${this.state.pump}`);
    },

    // Chronik
    log(msg) {
        this.memory.logs.push(msg);
        console.log(`[ENGINE] ${msg}`);
    }
};
